# --- Target Elasticsearch cluster ----------------------------------------
# Base URL of the cluster Elastick will inspect. Use https:// when TLS is on.
ELASTICSEARCH_URL=http://localhost:9200

# Credentials for Elastick to use against Elasticsearch.
# Recommended: a dedicated user with "monitor" + "manage" cluster privileges.
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me

# Set to false when Elasticsearch uses self-signed certificates.
ELASTIC_VERIFY_SSL=true

# Per-request timeout (seconds) when calling Elasticsearch.
ELASTIC_TIMEOUT=30

# --- Elastick service itself ---------------------------------------------
# Optional: when set, clients must send header "X-API-Key: <value>".
# Leave empty to disable authentication (fine for local development).
ELASTICK_API_KEY=

# Set to false to disable the bundled web UI (Swagger-only deployment).
# When disabled, /ui redirects to /docs.
ELASTICK_UI_ENABLED=true
